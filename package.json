{
  "name": "@osjs/osjs",
  "version": "3.1.12",
  "description": "OS.js",
  "main": "index.js",
  "scripts": {
    "test": "npm run eslint && npm run stylelint",
    "eslint": "eslint 'src/client/**/*.js' 'src/server/**/*.js'",
    "stylelint": "stylelint 'src/client/*.scss'",
    "serve": "node src/server/index.js",
    "build:manifest": "osjs-cli package:discover",
    "package:discover": "osjs-cli package:discover",
    "package:create": "osjs-cli package:create",
    "make:auth": "osjs-cli make:auth",
    "make:settings": "osjs-cli make:settings",
    "make:vfs": "osjs-cli make:vfs",
    "make:application": "osjs-cli make:application",
    "make:iframe-application": "osjs-cli make:iframe-application",
    "make:provider": "osjs-cli make:provider",
    "build": "node scripts/build-webpack.cjs production",
    "watch": "node scripts/build-webpack.cjs development watch"
  },
  "keywords": [
    "osjs"
  ],
  "author": "Anders Evenrud <andersevenrud@gmail.com>",
  "license": "BSD-2-Clause",
  "packageManager": "npm@11.20.0",
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.14",
    "@babel/runtime": "7.29.14",
    "@osjs/eslint-config": "2.0.1",
    "@osjs/stylelint-config": "2.0.1",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "eslint": "7.26.0",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "sass": "1.108.2",
    "sass-loader": "17.1.0",
    "source-map-loader": "5.0.0",
    "stylelint": "13.13.1",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "stylelint-config-standard": "20.0.0",
    "stylelint-scss": "3.20.1",
    "@osjs/cli": "^3.1.3"
  },
  "dependencies": {
    "@osjs/calculator-application": "^1.2.8",
    "@osjs/client": "file:vendor/osjs-client",
    "@osjs/common": "file:vendor/osjs-common",
    "@osjs/dialogs": "file:vendor/osjs-dialogs",
    "@osjs/draw-application": "^1.2.12",
    "@osjs/filemanager-application": "^1.6.2",
    "@osjs/freedesktop-sounds": "^3.0.3",
    "@osjs/gnome-icons": "^4.0.5",
    "@osjs/gui": "^4.0.36",
    "@osjs/htmlviewer-application": "^1.2.6",
    "@osjs/panels": "^3.0.31",
    "@osjs/preview-application": "^1.1.17",
    "@osjs/settings-application": "file:vendor/osjs-settings-application",
    "@osjs/standard-theme": "^4.0.9",
    "@osjs/textpad-application": "^1.2.7",
    "hyperapp": "^1.2.10",
    "typeface-roboto": "0.0.75"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osjs/OS.js.git"
  },
  "bugs": {
    "url": "https://github.com/osjs/OS.js/issues"
  },
  "homepage": "https://www.os-js.org",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": "11.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13.0 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.20.0",
      "onFail": "error"
    }
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true
    },
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": 8
    },
    "extends": "@osjs/eslint-config"
  },
  "stylelint": {
    "extends": "@osjs/stylelint-config"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {}
      ]
    ],
    "plugins": [
      "@babel/plugin-transform-runtime"
    ]
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
